<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <!-- One version for every Kaleido package (they ship together). -->
        <KaleidoVersion>1.0.0-preview-0432</KaleidoVersion>
    </PropertyGroup>
    <ItemGroup>
        <PackageVersion Include="Kaleido" Version="$(KaleidoVersion)" />
        <PackageVersion Include="Kaleido.Http" Version="$(KaleidoVersion)" />
        <PackageVersion Include="Kaleido.Http.Abstractions" Version="$(KaleidoVersion)" />
        <PackageVersion Include="Kaleido.Http.Client" Version="$(KaleidoVersion)" />
        <PackageVersion Include="Kaleido.Http.Mcp" Version="$(KaleidoVersion)" />
        <PackageVersion Include="Kaleido.Observability.OpenTelemetry" Version="$(KaleidoVersion)" />
        <PackageVersion Include="Kaleido.Provider.SQLite" Version="$(KaleidoVersion)" />
    </ItemGroup>
    <ItemGroup>
        <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="8.0.31" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.32" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.32" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.32" />
        <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
        <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
        <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="8.0.32" />
        <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="8.0.32" />
        <PackageVersion Include="Microsoft.Extensions.Http" Version="8.0.1" />
        <PackageVersion Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
        <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.0" />
        <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.0" />
        <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.0" />
        <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.0" />
        <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.0" />
        <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.3.0" />
        <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
    </ItemGroup>
    <ItemGroup Label="Tests">
        <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.32" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
        <PackageVersion Include="Moq" Version="4.21.0" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
        <PackageVersion Include="xunit.v3" Version="4.0.2" />
    </ItemGroup>
</Project>
