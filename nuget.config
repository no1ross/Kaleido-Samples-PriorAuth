<?xml version="1.0" encoding="utf-8"?>
<!-- Kaleido's preview packages come from its GitHub Packages feed, everything else from nuget.org.
     The feed needs a GitHub token with read:packages even for public packages: add it to your
     user-level NuGet configuration, never to this file (README, "Run it"). In CI the workflow's
     GITHUB_TOKEN reads it. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="kaleido" value="https://nuget.pkg.github.com/no1ross/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="kaleido">
      <package pattern="Kaleido" />
      <package pattern="Kaleido.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
