{
  "ConnectionStrings": {
    "Member": "Data Source=data/member.db"
  },
  "Kaleido": {
    "RoutePrefix": "member",
    "Processor": {
      "Name": "member",
      "Version": "1.0.0",
      "DisplayName": "Member",
      "Description": "Member processor."
    }
  },
  "OpenTelemetry": {
