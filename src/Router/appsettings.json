{
  "ReverseProxy": {
    "Routes": {
      "member-route": {
        "ClusterId": "member",
        "Match": { "Path": "/member/{**catch-all}" }
      },
      "referencedata-route": {
        "ClusterId": "referencedata",
        "Match": { "Path": "/referencedata/{**catch-all}" }
      },
      "provider-route": {
        "ClusterId": "provider",
        "Match": { "Path": "/provider/{**catch-all}" }
      },
      "codeset-route": {
        "ClusterId": "codeset",
        "Match": { "Path": "/codeset/{**catch-all}" }
      },
      "configuration-route": {
        "ClusterId": "configuration",
        "Match": { "Path": "/configuration/{**catch-all}" }
      },
      "intake-route": {
        "ClusterId": "intake",
        "Match": { "Path": "/intake/{**catch-all}" }
      },
      "radiology-route": {
        "ClusterId": "radiology",
        "Match": { "Path": "/radiology/{**catch-all}" }
      },
      "history-route": {
        "ClusterId": "history",
        "Match": { "Path": "/history/{**catch-all}" }
      },
      "member-swagger-route": {
        "ClusterId": "member",
        "Match": { "Path": "/swagger/services/member/swagger.json" },
        "Transforms": [ { "PathSet": "/swagger/v1/swagger.json" } ]
      },
      "referencedata-swagger-route": {
        "ClusterId": "referencedata",
        "Match": { "Path": "/swagger/services/referencedata/swagger.json" },
        "Transforms": [ { "PathSet": "/swagger/v1/swagger.json" } ]
      },
      "provider-swagger-route": {
        "ClusterId": "provider",
        "Match": { "Path": "/swagger/services/provider/swagger.json" },
        "Transforms": [ { "PathSet": "/swagger/v1/swagger.json" } ]
      },
      "codeset-swagger-route": {
        "ClusterId": "codeset",
        "Match": { "Path": "/swagger/services/codeset/swagger.json" },
        "Transforms": [ { "PathSet": "/swagger/v1/swagger.json" } ]
      },
      "configuration-swagger-route": {
        "ClusterId": "configuration",
        "Match": { "Path": "/swagger/services/configuration/swagger.json" },
        "Transforms": [ { "PathSet": "/swagger/v1/swagger.json" } ]
      },
      "intake-swagger-route": {
        "ClusterId": "intake",
        "Match": { "Path": "/swagger/services/intake/swagger.json" },
        "Transforms": [ { "PathSet": "/swagger/v1/swagger.json" } ]
      },
      "radiology-swagger-route": {
        "ClusterId": "radiology",
        "Match": { "Path": "/swagger/services/radiology/swagger.json" },
        "Transforms": [ { "PathSet": "/swagger/v1/swagger.json" } ]
      },
      "history-swagger-route": {
        "ClusterId": "history",
        "Match": { "Path": "/swagger/services/history/swagger.json" },
        "Transforms": [ { "PathSet": "/swagger/v1/swagger.json" } ]
      },
      "ui-route": {
        "ClusterId": "ui",
        "Match": { "Path": "{**catch-all}" },
        "Order": 100
      }
    },
    "Clusters": {
      "member":        { "Destinations": { "primary": { "Address": "http://member:8080" } } },
      "referencedata": { "Destinations": { "primary": { "Address": "http://referencedata:8080" } } },
      "provider":      { "Destinations": { "primary": { "Address": "http://provider:8080" } } },
      "codeset":       { "Destinations": { "primary": { "Address": "http://codeset:8080" } } },
      "configuration": { "Destinations": { "primary": { "Address": "http://configuration:8080" } } },
      "intake":        { "Destinations": { "primary": { "Address": "http://intake:8080" } } },
      "radiology":     { "Destinations": { "primary": { "Address": "http://radiology:8080" } } },
      "history":       { "Destinations": { "primary": { "Address": "http://history:8080" } } },
      "ui":            { "Destinations": { "primary": { "Address": "http://priorauth-ui:8080" } } }
    }
  },
  "Kaleido": {
    "ServiceName": "router",
    "Mcp": {
      "ToolListing": "FrontDoor",
      "ListedTools": [ "history_prior_auth_record_list" ],
      "AdditionalInstructions": "You take prior authorization requests the way a call center agent does. When the conversation starts, start an intake right away (intake_start_intake), greet the caller and ask, in one question, for the member's ID, first and last name and date of birth, the service that needs to be rendered, and the date of service. From then on pass that processId on every call, searches included: every query of a request must be recorded with it. Find the member with Member Search (member ID or last name, with a date-of-birth filter); several members can match, for example twins on a family plan share the member ID, so read the matches back (name, member ID, plan, coverage dates) and let the caller pick one. Find the service with Procedure Codes and let the caller confirm the code. Then validate and capture the member and capture the requested service. The request may be handed off to another service (e.g. radiology), which may ask its own questions: ask the caller each one exactly as written and never answer for them. Its steps and the provider searches they need are described in next; run them with call_tool."
    },
    "RegistryTtl": "00:00:30",
    "Clients": {
      "member": { "BaseUrl": "http://member:8080" },
      "referencedata": { "BaseUrl": "http://referencedata:8080" },
      "provider": { "BaseUrl": "http://provider:8080" },
      "codeset": { "BaseUrl": "http://codeset:8080" },
      "configuration": { "BaseUrl": "http://configuration:8080" },
      "intake": { "BaseUrl": "http://intake:8080" },
      "radiology": { "BaseUrl": "http://radiology:8080" },
      "history": { "BaseUrl": "http://history:8080" }
    },
    "OpenTelemetry": {
      "Endpoint": "http://aspire-dashboard:18889",
      "Protocol": "grpc",
      "ResourceAttributes": "deployment.environment=Development,service.version=1.0.0"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
