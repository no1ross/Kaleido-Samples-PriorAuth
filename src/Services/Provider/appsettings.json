{
  "ConnectionStrings": {
    "Provider": "Data Source=data/provider.db"
  },
  "Services": {
    "EventCollector": { "BaseUrl": "http://eventcollector:8080" }
  },
  "Kaleido": {
    "ServiceName": "provider",
    "DisplayName": "Provider Service",
    "Description": "Provider Search and Snapshots",
    "Clients": {
      "ReferenceData": { "BaseUrl": "http://referencedata:8080" }
    },
    "OpenTelemetry": {
      "Endpoint": "http://aspire-dashboard:18889",
      "Protocol": "grpc",
      "ResourceAttributes": "deployment.environment=Development,service.version=1.0.0"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
