{
  "ConnectionStrings": {
    "ProviderSearch": "Data Source=../data/providersearch.db"
  },
  "Services": {
    "ReferenceData": {
      "BaseUrl": "http://localhost:8081",
      "PlanQueryPath": "/reference-data/queryable/plans/query"
    },
    "EventCollector": {
      "BaseUrl": "http://localhost:8086"
    }
  },
  "OpenTelemetry": {
    "Endpoint": "http://localhost:4317",
    "Protocol": "grpc",
    "ServiceName": "priorauth-providersearch",
    "ResourceAttributes": "deployment.environment=Development,service.version=1.0.0"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
