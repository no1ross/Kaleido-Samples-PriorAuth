{
  "ConnectionStrings": {
    "Intake": "Data Source=data/intake.dev.db",
    "IntakeProcess": "Data Source=data/intake-process.dev.db"
  },
  "Services": {
    "ReferenceData": {
      "BaseUrl": "http://localhost:8081"
    },
    "MemberService": {
      "BaseUrl": "http://localhost:8084"
    },
    "EventCollector": {
      "BaseUrl": "http://localhost:8086"
    }
  },
  "OpenTelemetry": {
