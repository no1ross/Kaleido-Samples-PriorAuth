{
  "ConnectionStrings": {
    "Intake": "Data Source=../data/intake.db",
    "IntakeProcess": "Data Source=../data/intake-process.db"
  },
  "Services": {
    "ReferenceData": {
      "BaseUrl": "http://localhost:8081"
    },
    "MemberService": {
      "BaseUrl": "http://localhost:8084",
      "MemberDetailsQueryPath": "/member/queryable/members/member-details/query"
    },
    "CodeSet": {
      "BaseUrl": "http://localhost:8082",
      "ProcedureCodeQueryPath": "/code-set/queryable/procedure-codes/query"
    },
    "Configuration": {
      "BaseUrl": "http://localhost:8087",
      "ProcedureModalityRuleQueryPath": "/configuration/queryable/procedure-modality-rules/query",
      "MriProcedureCodeRuleQueryPath": "/configuration/queryable/mri-procedure-code-rules/query",
      "QuestionnaireDefinitionViewPath": "/configuration/queryable/questionnaire-definitions/questionnaire-definition/query"
    },
    "ProviderSearch": {
      "BaseUrl": "http://localhost:8083",
      "RequestingProviderSearchQueryPath": "/provider/queryable/requesting-providers/requesting-provider-search/query"
    },
    "EventCollector": {
      "BaseUrl": "http://localhost:8086"
    }
  },
  "OpenTelemetry": {
    "Endpoint": "http://localhost:4317",
    "Protocol": "grpc",
    "ServiceName": "priorauth-intake",
    "ResourceAttributes": "deployment.environment=Development,service.version=1.0.0"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
