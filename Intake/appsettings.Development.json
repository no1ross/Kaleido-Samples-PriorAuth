{
  "ConnectionStrings": {
    "Intake": "Data Source=../data/intake.db",
    "IntakeProcess": "Data Source=../data/intake-process.db"
  },
  "Kaleido": {
    "Processor": {
      "IsEntryProcessor": true
    },
    "BaseUrl": "http://localhost:8080",
    "Clients": {}
