{
  "ConnectionStrings": {
    "Configuration": "Data Source=../data/configuration.db"
  },
  "Services": {
    "EventCollector": {
      "BaseUrl": "http://localhost:8086"
    }
  },
  "OpenTelemetry": {
    "Endpoint": "http://localhost:4317",
    "Protocol": "grpc",
    "ServiceName": "priorauth-configuration",
    "ResourceAttributes": "deployment.environment=Development,service.version=1.0.0"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
