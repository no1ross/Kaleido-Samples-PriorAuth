{
  "ConnectionStrings": {
    "Provider": "Data Source=../data/provider.db"
  },
  "Kaleido": {
    "Clients": {
      "ReferenceData": {
        "BaseUrl": "http://localhost:8081"
      }
    }
  },
  "OpenTelemetry": {
